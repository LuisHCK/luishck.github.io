---
import ProjectCard from '../project-card/ProjectCard.astro'
import { getProjectCover } from '../../data/covers'

const { title = '', description = '', projects = [] } = Astro.props
const sortedProjects = [...projects].sort((a, b) => a.order - b.order)
---
<section class="box">
    <h3 class="is-size-3 has-text-weight-bold">{title}</h3>
    <p>{description}</p>

    <div class="columns is-mobile is-multiline mt-3">
        {sortedProjects.map((project) => (
            <div class="column is-half-desktop is-full-mobile">
                <ProjectCard
                    slug={project.slug}
                    name={project.name}
                    description={project.description}
                    image={getProjectCover(project.slug) ?? project.cover}
                    stack={project.stack}
                    links={project.links}
                />
            </div>
        ))}
    </div>
</section>

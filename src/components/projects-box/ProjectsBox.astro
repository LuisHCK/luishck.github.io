---
import type { CollectionEntry } from 'astro:content'
import ProjectCard from '../project-card/ProjectCard.astro'

const { title = '', description = '' } = Astro.props
const projects: CollectionEntry<'projects'>[] = Astro.props.projects ?? []
---
<section class="box">
    <h3 class="is-size-3 has-text-weight-bold">{title}</h3>
    <p>{description}</p>

    <div class="columns is-mobile is-multiline mt-3">
        {projects.map((project) => (
            <div class="column is-half-desktop is-full-mobile">
                <ProjectCard
                    slug={project.id}
                    name={project.data.name}
                    description={project.data.description}
                    image={project.data.cover}
                    stack={project.data.stack}
                    links={project.data.links}
                />
            </div>
        ))}
    </div>
</section>

---
import { Image } from 'astro:assets'
import Icon from '../icon/Icon.astro'

const {
    slug,
    name,
    description,
    image,
} = Astro.props

const stack: string[] = Astro.props.stack ?? []
const links: Array<{ label: string; url: string; target?: string; rel?: string }> =
    Astro.props.links ?? []

const detailsUrl =
    links.find((link) => link.label === 'Project details')?.url ?? `/projects/${slug}`
---
<div class="ProjectCard card">
    <div class="card-image">
        <a
            class="ProjectCard-imageLink"
            href={detailsUrl}
            aria-label={`View ${name} project details`}
            data-umami-event="project_image_click"
            data-umami-event-type="click"
        >
            <figure class="image is-16by9">
                <Image
                    src={image}
                    alt={name}
                    class="adjusted-image"
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    format="webp"
                    quality={82}
                    loading="lazy"
                    decoding="async"
                />
            </figure>
        </a>
    </div>

    <div class="card-content">
        <div class="is-flex is-justify-content-space-between">
            <h4 class="has-text-weight-bold">{name}</h4>

            <div>
                {stack.map((technology) => (
                    <Icon name={technology} width="22px" height="22px" />
                ))}
            </div>
        </div>

        <div class="content">{description}</div>
    </div>

    <footer class="card-footer">
        {links.map((link) => (
            <div class="card-footer-item">
                <a
                    href={link.url}
                    class="has-text-centered"
                    target={link.target}
                    rel={link.rel}
                    data-umami-event={`project_${link.label.toLowerCase()}_click`}
                    data-umami-event-type="click"
                >
                    {link.label}
                </a>
            </div>
        ))}
    </footer>
</div>

---
import { Profile } from '../../data'
---
<nav class="navbar is-dark" role="navigation" aria-label="main navigation">
    <div class="navbar-brand">
        <a
            href="/"
            class="navbar-item has-text-weight-bold"
            aria-label={Profile.name}
        >
            <img src="/images/logo.png" height="28" width="28" alt={Profile.name} />
        </a>

        <button
            type="button"
            class="navbar-burger"
            aria-label="menu"
            aria-expanded="false"
            data-target="navbarMenu"
        >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>
    </div>

    <div id="navbarMenu" class="navbar-menu closed">
        <div class="navbar-start">
            <a
                href="/"
                class="navbar-item"
                data-umami-event="home_link_click"
                data-umami-event-type="click"
            >
                Home
            </a>

            <a
                href="/projects"
                class="navbar-item"
                data-umami-event="projects_link_click"
                data-umami-event-type="click"
            >
                Projects
            </a>

            <a
                href={Profile.cv}
                class="navbar-item is-flex is-align-items-center"
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="cv_link_click"
                data-umami-event-type="click"
            >
                Resume
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
                    <path d="M7 11l5 5l5-5" />
                    <path d="M12 4v12" />
                </svg>
            </a>
        </div>
    </div>
</nav>

<script>
    const burger = document.querySelector('.navbar-burger')

    if (burger) {
        burger.addEventListener('click', () => {
            const target = burger.getAttribute('data-target')
            const menu = target ? document.getElementById(target) : null

            if (!menu) return

            const isOpen = menu.classList.toggle('open')
            menu.classList.toggle('closed', !isOpen)
            burger.setAttribute('aria-expanded', String(isOpen))
        })
    }
</script>
